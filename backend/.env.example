# Copy to ".env" to override defaults. Every value is optional.
# GhostGrid needs no API keys or paid services: the database is a local SQLite file. External integrations (below) are optional.
# Do not put real credentials in this example file; ".env" itself is git-ignored.

# Port and interface for the API / production server.
PORT=8787
HOST=127.0.0.1

# SQLite database file (created automatically). Relative paths resolve from the project folder.
GHOSTGRID_DB=data/ghostgrid.db

# On the very first start, add the bundled simulated sample scenarios. Set to false for an empty workspace.
GHOSTGRID_SEED_SAMPLES=true

# Part 1 stored data in a JSON file. If this file exists and the database is empty, it is imported once.
GHOSTGRID_LEGACY_JSON=data/db.json

# Development only: where the Vite dev server proxies /api requests.
# GHOSTGRID_API=http://127.0.0.1:8787

# Python interpreter used for graph feature extraction, and how many extractions may run at once.
# GHOSTGRID_PYTHON=python3
# GHOSTGRID_FEATURE_CONCURRENCY=2

# ---------------------------------------------------------------------------------------------------------------
# External integrations (all optional). Leave a value empty to leave that service off; GhostGrid runs without any.
# Keys are read only by the backend and are never sent to the browser. Keep real values in backend/.env (git-ignored).
# ---------------------------------------------------------------------------------------------------------------

# AI explanations. Gemini is the primary provider; Groq is used as a fallback when Gemini is rate limited,
# times out or is unavailable (not for bad keys or rejected requests).
GEMINI_API_KEY=
GROQ_API_KEY=
# GHOSTGRID_AI_PROVIDER=auto        # auto | gemini | groq  (can also be changed in Settings)
# GHOSTGRID_AI_FALLBACK=true
# GEMINI_MODEL=gemini-2.5-flash     # change if Google retires a model name
# GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face: public search works without a token; a read token adds private/gated repositories and higher limits.
HF_TOKEN=

# Kaggle dataset discovery and import (both values are required).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Weights & Biases experiment tracking (needs: pip install wandb).
WANDB_API_KEY=
# WANDB_PROJECT=ghostgrid
# WANDB_ENTITY=

# Google Maps is not used: GhostGrid assets have no geographic coordinates. Reserved for a future module.
GOOGLE_MAPS_API_KEY=

# Largest dataset GhostGrid will download on request, in megabytes.
# GHOSTGRID_IMPORT_MAX_MB=250
