    "features": "python3 -m ml.feature_engineering.cli"
  },
  "dependencies": { "express": "^5.1.0" },
  "devDependencies": { "@types/express": "^5.0.0", "@types/node": "^22.10.0", "vitest": "^5.1.0" }
