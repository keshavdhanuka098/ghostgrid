{
  "name": "@ghostgrid/backend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "GhostGrid Node API (Express + SQLite), the shared cascade engine and the Python ML workspace.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "node --watch server/index.mjs",
