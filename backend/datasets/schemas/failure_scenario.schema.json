{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GhostGrid failure scenario record",
  "type": "object",
  "required": ["record_id", "graph_id", "graph", "failed_asset_ids"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "graph_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string"},
    "graph": {"$ref": "graph.schema.json"},
    "failed_asset_ids": {"type": "array", "items": {"type": "string"}},
    "failed_dependency_ids": {"type": "array", "items": {"type": "string"}},
    "observed_failed_asset_ids": {"type": "array", "items": {"type": "string"}},
    "recovery_time_seconds": {"type": "number", "minimum": 0},
    "source": {"type": "object"}
  },
  "additionalProperties": true
}
