{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@engine/*": ["../backend/engine/*"], "@shared/*": ["../backend/shared/*"] },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "../backend/engine"],
  "exclude": ["../backend/engine/*.test.ts"]
}
